graph TD
    subgraph UI ["Interfaz de Usuario - Excel (UI y Control)"]
        Buttons["Botones de Control: Ejecutar, Reset, Cargar Programa A/B/C"]
        LogPanel["Panel de Log de Micro-operaciones (Cronológico)"]
    end

    subgraph CPU ["Unidad Central de Procesamiento (CPU)"]
        subgraph CU ["Unidad de Control"]
            PC["Program Counter (PC)"]
            MAR["Memory Address Register (MAR)"]
            MDR["Memory Data Register (MDR)"]
            IR["Instruction Register (IR)"]
            FDE["Ciclo Fetch-Decode-Execute (VBA Select Case)"]
        end

        subgraph ALU ["Unidad Aritmética Lógica (ALU)"]
            AX["Registro Acumulador (AX)"]
            BX["Registro Contador (BX)"]
            Flags["Banderas: ZF (Zero), CF (Carry), SF (Sign)"]
        end
    end

    subgraph Memory ["Memoria Principal (RAM)"]
        RAM["RAM (256 celdas / 00h - FFh)"]
    end

    %% Flujos y Buses
    Buttons -->|Inicia Ciclo| FDE
    FDE -->|1. Lee PC| MAR
    MAR -->|Bus de Direcciones| RAM
    RAM -->|Bus de Datos| MDR
    MDR -->|Carga| IR
    IR --> FDE
    
    FDE -->|Ejecuta Operación| ALU
    ALU --> AX
    ALU --> BX
    ALU --> Flags
    
    %% Lectura/Escritura de Datos en RAM
    FDE -->|STORE / LOAD| RAM
    
    %% Retroalimentación a la Interfaz
    FDE -->|Resaltado Visual / Colores| UI
    FDE -->|Agrega Evento| LogPanel
    Flags -->|Evaluación de Saltos JZ / JNZ| FDE
